# Copia questo file in ".env" e scrivi la tua chiave dopo l'uguale:
#   cp .env.example .env
#
# La chiave si prende da mapbox.com → Account → Access tokens e deve essere una
# chiave *pubblica* (inizia con "pk."): questa pagina gira nel browser, quindi una
# chiave segreta ("sk.") finirebbe sotto gli occhi di chiunque apra il sito.
#
# ".env" non viene versionato: vedi .gitignore.
MAPBOX_TOKEN=
